# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def isPalindrome(self, head: Optional[ListNode]) -> bool:
        if head == None:
            return None

        slow = head
        fast = head
        while fast.next != None and fast.next.next != None:
            slow = slow.next
            fast = fast.next.next
        
        curr = self.reverse(slow.next)
        slow.next = None

        slow = head

        while slow != None and curr != None:
            if slow.val != curr.val:
                return False
            slow = slow.next
            curr = curr.next

        return True
    
    def reverse(self, head: Optional[ListNode]) -> ListNode:
        if head == None:
            return None

        prev = None
        curr = head
        temp = curr.next

        while temp:
            curr.next = prev
            prev = curr
            curr = temp
            temp = temp.next

        curr.next = prev
        return curr